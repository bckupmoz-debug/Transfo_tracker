# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# Server-only key for the Python extraction function (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# NextAuth / Keycloak
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_KEYCLOAK_ID="your-keycloak-client-id"
AUTH_KEYCLOAK_SECRET="your-keycloak-client-secret"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/your-realm"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional local Keycloak admin values when spinning up a local container
KEYCLOAK_ADMIN="test"
KEYCLOAK_ADMIN_PASSWORD="test"

